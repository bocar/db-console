# EditorConfig - Google Java Style Guide
# https://google.github.io/styleguide/javaguide.html

root = true

# 全局配置
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
tab_width = 2

# Java - Google Java Style
[*.java]
indent_style = space
indent_size = 2
tab_width = 2
max_line_length = 100

# Maven / XML
[*.{xml,pom}]
indent_size = 2

# YAML
[*.{yml,yaml}]
indent_size = 2

# JSON
[*.json]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false

# Shell
[*.sh]
indent_size = 2

# Properties
[*.properties]
indent_size = 2
