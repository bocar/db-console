# db-console 运行环境变量（复制为 dbconsole.env 并填写，权限设为 600）
# 供 systemd 的 EnvironmentFile 加载；裸进程部署时可在启动前 source 本文件。

# 登录密码（必填，对应 config/db-console.yml 中 login.password 的引用）
DB_CONSOLE_ADMIN_PASSWORD=replace-with-a-login-password

# 各数据源凭据：与 config/datasources.yml 中 credential-ref 引用的变量名一一对应
# DB_CONSOLE_MYSQL_DEVELOPMENT_PASSWORD=
# DB_CONSOLE_MYSQL_WORKNOTE_PASSWORD=
# DB_CONSOLE_DM8_NAVIC_PASSWORD=

# JVM 参数（可选）
# JAVA_OPTS=-Xms256m -Xmx1g
