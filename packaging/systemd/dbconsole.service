# db-console systemd 服务模板（随信创发行包提供）
#
# 安装：
#   1) 部署目录不是 /opt/dbconsole 时，同步修改下方 WorkingDirectory /
#      ExecStart / EnvironmentFile 三处路径
#   2) cp 本文件 /etc/systemd/system/dbconsole.service
#   3) systemctl daemon-reload && systemctl enable --now dbconsole
#
# 环境变量（数据库凭据等敏感信息）统一放在 EnvironmentFile 指向的文件中，
# 由 config/dbconsole.env.example 复制而来，权限应为 600。

[Unit]
Description=db-console database web console
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
WorkingDirectory=/opt/dbconsole
ExecStart=/opt/dbconsole/bin/start.sh
EnvironmentFile=/opt/dbconsole/config/dbconsole.env
# 崩溃自动拉起；停机窗口留足执行中语句的取消时间
Restart=on-failure
RestartSec=5
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
